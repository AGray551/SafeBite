# Copy to .env.local and fill in as needed.

# Base URL of the SafeBite API. Leave empty to use the built-in mock API.
VITE_API_BASE_URL=

# Supabase project for student accounts (sign-in, dietary profile, favorites, reports).
# Dashboard → Project Settings → API Keys. Leave empty to keep accounts in the mock.
# The publishable key (sb_publishable_…, or the legacy anon key) is meant for browsers;
# never put the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" to use the mock API for everything, even when the values above are set.
VITE_USE_MOCK_API=false
